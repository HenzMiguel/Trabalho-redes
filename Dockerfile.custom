FROM frrouting/frr:latest

# A imagem oficial usa Alpine Linux.
USER root
RUN apk add --no-cache build-base tcpdump

# Compila o daemon de roteamento baseado em latência.
COPY latency_router.c /tmp/latency_router.c
RUN gcc -O2 -Wall -Wextra -Werror -pthread /tmp/latency_router.c -o /usr/local/bin/latency_router \
    && rm /tmp/latency_router.c

# Substitui o entrypoint do FRR pelo nosso daemon C.
# O tini garante tratamento correto de sinais e processos filhos (ping).
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/latency_router"]
